# Example server profile for single-GPU (32 GB VRAM) NVFP4 + CTC timestamp serving.
# Copy to configs/vllm_rtx5090.env (ignored by Git) and adjust paths for your host.

MODEL_PATH=/path/to/models/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4
SERVED_MODEL_NAME=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4

HOST=127.0.0.1
PORT=8190

# Optional bearer token if serving behind an authenticated endpoint
# VLLM_API_KEY=replace-with-local-key

GPU_MEMORY_UTILIZATION=0.78
MAX_MODEL_LEN=32768
MAX_NUM_BATCHED_TOKENS=2048
MAX_NUM_SEQS=4
ENABLE_MTP=0
