# Example client & host runtime environment variables for ASR, refinement, and translation.
# Copy to .env (ignored by Git) or source before running CLI commands.

# ASR vLLM OpenAI-compatible endpoint
ASR_BASE_URL=http://127.0.0.1:8190/v1
ASR_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4
# VLLM_API_KEY=EMPTY

# Reasoning / contextual text refinement & translation endpoint (e.g., SwiftU / NInfer / OpenAI-compatible)
SWIFTU_BASE_URL=http://127.0.0.1:8001/v1
SWIFTU_MODEL=chat

# Optional CUDA & local cache directories
# CUDA_HOME=/usr/local/cuda
# VLLM_CACHE_ROOT=.cache/vllm
# FLASHINFER_WORKSPACE_BASE=.cache/flashinfer
