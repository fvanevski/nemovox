# Optional environment overrides for the model-resource registry.
# Copy to .env (ignored by Git) and source before running CLI or Studio.
# Host configuration may instead be supplied by NEMOVOX_MODEL_RESOURCES.
# NEMOVOX_MODEL_RESOURCES=/workspace/nvidia-transcribe/configs/model-resources.local.json

# ASR vLLM OpenAI-compatible endpoint
ASR_BASE_URL=http://127.0.0.1:8190/v1
ASR_MODEL=nvidia/NVIDIA-Nemotron-3.5-Transcribe-30B-A4B-NVFP4
# VLLM_API_KEY=EMPTY

# OpenAI-compatible text inference (default host binding: SwiftU/NInfer)
TEXT_BASE_URL=http://127.0.0.1:8001/v1
TEXT_MODEL=chat

# Optional CUDA & local cache directories
# CUDA_HOME=/usr/local/cuda
# VLLM_CACHE_ROOT=.cache/vllm
# FLASHINFER_WORKSPACE_BASE=.cache/flashinfer
