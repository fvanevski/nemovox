# NON-RUNNABLE CONFIGURATION TEMPLATE: host integration must replace ExecStart
# with the verified local NInfer/SwiftU/OpenAI-compatible text-model launcher.
# The endpoint and served-model marker MUST exactly match the selected model
# resource binding in configs/model-resources.local.json. Do not enable at boot.
[Unit]
Description=Nemovox explicitly managed English translation review text model
[Service]
Type=exec
WorkingDirectory=/workspace/nvidia-transcribe
Environment=NEMOVOX_MANAGED_RESOURCE=1
Environment=NEMOVOX_RESOURCE_NAME=text_local
Environment=NEMOVOX_RESOURCE_MODEL=chat
Environment=NEMOVOX_RESOURCE_ENDPOINT=http://127.0.0.1:8001/v1
ExecStart=/path/to/VERIFIED_TEXT_MODEL_LAUNCHER
KillMode=control-group
Restart=no
TimeoutStopSec=30
