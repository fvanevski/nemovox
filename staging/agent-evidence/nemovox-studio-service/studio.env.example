# Optional host-specific overrides for ~/.config/nemovox/studio.env.
# This file is parsed by systemd EnvironmentFile=, not by a shell.
# Keep the effective file mode 0600. Never commit populated values.
#
# Additional allowed media roots (colon-separated):
# NEMOVOX_MEDIA_ROOTS=/path/to/media:/path/to/library
#
# Configure ASR/SwiftU only after validating actual running endpoints/model IDs.
# ASR_BASE_URL=...
# ASR_MODEL=...
# SWIFTU_BASE_URL=...
# SWIFTU_MODEL=...
#
# If binaries (ffmpeg, ffprobe or yt-dlp) are in nonstandard host directories:
# PATH=/absolute/extra/bin:/home/USER/.local/bin:/usr/local/bin:/usr/bin:/bin
