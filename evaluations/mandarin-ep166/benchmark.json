            "id": "utt-0033",
            "start": 408.032,
            "end": 422.129,
            "duration": 14.097,
            "timing_status": "partial",
            "source_chars": 17,
            "text": "Grandpa, you're the one rushing to pick an heir to guard the Spirit Palace."
          },
